"use client";

import React, { useState } from "react";
import { useRouter } from "next/navigation";
import { EditContentModal } from "@/components/DashboardFlow/EditContentModal";
import { AddContentModal } from "@/components/DashboardFlow/AddContentModal";
import { ExerciseBuilderModal } from "@/components/Exercise/ExerciseBuilderModal";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  ArrowLeft,
  Plus,
  BookOpen,
  FileText,
  Video,
  Brain,
  Edit2,
  Trash2,
  Eye,
  ChevronDown,
} from "lucide-react";

interface CourseDashboardProps {
  course: any;
  modules: any[];
  lessons: any[];
  materials: any[];
  exercises: any[];
  onCreateModule: () => void;
  onEditModule: (module: any) => void;
  onDeleteModule: (moduleId: string) => void;
  onCreateLesson: (moduleId: string) => void;
  onCreateMaterial: (moduleId: string) => void;
  onCreateExercise: (moduleId: string) => void;
  onEditLesson: (lesson: any) => void;
  onEditMaterial: (material: any) => void;
  onEditExercise: (exercise: any) => void;
  onDeleteLesson: (lessonId: string) => void;
  onDeleteMaterial: (materialId: string) => void;
  onDeleteExercise: (exerciseId: string) => void;
  onPreviewLesson: (lesson: any) => void;
  onPreviewMaterial: (material: any) => void;
  onPreviewExercise: (exercise: any) => void;
  onAddModule: (module: any) => void;
  onAddLesson: (lesson: any) => void;
  onAddMaterial: (material: any) => void;
  onAddExercise: (exercise: any) => void;
  courseId: string;
  user: any;
}

export function CourseDashboard({
  course,
  modules,
  lessons,
  materials,
  exercises,
  onCreateModule,
  onEditModule,
  onDeleteModule,
  onCreateLesson,
  onCreateMaterial,
  onCreateExercise,
  onEditLesson,
  onEditMaterial,
  onEditExercise,
  onDeleteLesson,
  onDeleteMaterial,
  onDeleteExercise,
  onPreviewLesson,
  onPreviewMaterial,
  onPreviewExercise,
  onAddModule,
  onAddLesson,
  onAddMaterial,
  onAddExercise,
  courseId,
  user,
}: CourseDashboardProps) {
  const router = useRouter();
  const [expandedModules, setExpandedModules] = useState<Set<string>>(new Set());
  const [editModalState, setEditModalState] = useState<{
    isOpen: boolean;
    type: "lesson" | "material" | "exercise" | "module";
    initialData: any;
  }>({
    isOpen: false,
    type: "lesson",
    initialData: null,
  });

  const [addModalState, setAddModalState] = useState<{
    isOpen: boolean;
    type: "lesson" | "material" | "exercise" | "module";
    moduleId?: string;
  }>({
    isOpen: false,
    type: "lesson",
    moduleId: undefined,
  });

  const [showExerciseBuilder, setShowExerciseBuilder] = useState(false);

  const toggleModule = (moduleId: string) => {
    setExpandedModules(prev => {
      const newSet = new Set(prev);
      if (newSet.has(moduleId)) {
        newSet.delete(moduleId);
      } else {
        newSet.add(moduleId);
      }
      return newSet;
    });
  };

  return (
    <div className="min-h-screen" style={{ background: 'linear-gradient(135deg, rgba(255,255,255,1) 0%, rgba(255,253,248,1) 100%)' }}>
      {/* Course Header */}
      <div style={{ backgroundColor: '#1A1A1A' }} className="relative overflow-hidden">
        {/* Decorative Blobs */}
        <div className="absolute top-0 left-0 w-32 h-32 rounded-full blur-3xl opacity-20" style={{ backgroundColor: '#E8B824' }}></div>
        <div className="absolute top-0 right-0 w-48 h-48 rounded-full blur-3xl opacity-15" style={{ backgroundColor: '#E8B824' }}></div>
        <div className="absolute bottom-0 left-1/2 w-64 h-64 rounded-full blur-3xl opacity-10" style={{ backgroundColor: '#E8B824' }}></div>
        
        <div className="relative z-10 max-w-7xl mx-auto px-6 py-8">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <Button
                onClick={() => router.push('/app/home/teacher')}
                className="p-2 rounded-lg hover:bg-yellow-50 transition-colors"
                style={{ backgroundColor: 'rgba(255, 255, 252, 0.1)', border: '1px solid rgba(255, 255, 252, 0.2)' }}
                onMouseEnter={(e) => {
                  e.currentTarget.style.backgroundColor = 'rgba(232, 184, 36, 0.1)';
                }}
                onMouseLeave={(e) => {
                  e.currentTarget.style.backgroundColor = 'rgba(255, 255, 252, 0.1)';
                }}
              >
                <ArrowLeft className="h-5 w-5" style={{ color: '#FFFFFC' }} />
              </Button>
              <div>
                <h1 className="text-3xl font-bold mb-2" style={{ color: '#FFFFFC' }}>
                  {course?.title || "Course Dashboard"}
                </h1>
                <p className="text-gray-300" style={{ color: 'rgba(255, 255, 252, 0.7)' }}>
                  Kelola konten kursus Anda dengan mudah
                </p>
              </div>
            </div>
            <div className="flex items-center gap-3">
              <div className="px-4 py-2 rounded-full" style={{ backgroundColor: 'rgba(255, 255, 252, 0.1)', border: '1px solid rgba(255, 255, 252, 0.2)' }}>
                <span className="text-sm font-semibold" style={{ color: '#FFFFFC' }}>
                  {modules.length} Modul
                </span>
              </div>
              <div className="px-4 py-2 rounded-full" style={{ backgroundColor: 'rgba(255, 255, 252, 0.1)', border: '1px solid rgba(255, 255, 252, 0.2)' }}>
                <span className="text-sm font-semibold" style={{ color: '#FFFFFC' }}>
                  {lessons.length} Pelajaran
                </span>
              </div>
              <div className="px-4 py-2 rounded-full" style={{ backgroundColor: 'rgba(255, 255, 252, 0.1)', border: '1px solid rgba(255, 255, 252, 0.2)' }}>
                <span className="text-sm font-semibold" style={{ color: '#FFFFFC' }}>
                  {materials.length} Materi
                </span>
              </div>
              <div className="px-4 py-2 rounded-full" style={{ backgroundColor: 'rgba(255, 255, 252, 0.1)', border: '1px solid rgba(255, 255, 252, 0.2)' }}>
                <span className="text-sm font-semibold" style={{ color: '#FFFFFC' }}>
                  {exercises.length} Latihan
                </span>
              </div>
            </div>
          </div>
        </div>
        {/* Bottom Border */}
        <div className="h-1" style={{ background: 'linear-gradient(90deg, #E8B824 0%, rgba(232, 184, 36, 0) 100%)' }}></div>
      </div>

            {/* Lessons Card */}
            <div className="rounded-xl p-6 transition-all duration-300 hover:shadow-lg cursor-pointer backdrop-blur-md" style={{
              backgroundColor: 'rgba(255, 255, 252, 0.1)',
              borderColor: 'rgba(232, 184, 36, 0.2)',
              borderWidth: '1px'
            }} onMouseEnter={(e) => {
              e.currentTarget.style.transform = 'translateY(-4px)';
              e.currentTarget.style.boxShadow = '0 12px 28px rgba(232, 184, 36, 0.15)';
            }} onMouseLeave={(e) => {
              e.currentTarget.style.transform = 'translateY(0)';
              e.currentTarget.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.1)';
            }}>
              <div className="flex items-start justify-between">
                <div className="flex-1">
                  <p className="text-gray-300 text-sm mb-3">Pelajaran</p>
                  <p className="text-4xl font-bold mb-1" style={{ color: '#FFFFFC' }}>{lessons.length}</p>
                  <p className="text-gray-400 text-xs">Total pelajaran</p>
                </div>
                <div className="p-3 rounded-lg transform transition-transform hover:scale-110" style={{backgroundColor: '#E8B824'}}>
                  <FileText className="h-6 w-6" style={{color: '#1E1E1E'}} />
                </div>
              </div>
            </div>

            {/* Materials Card */}
            <div className="rounded-xl p-6 transition-all duration-300 hover:shadow-lg cursor-pointer backdrop-blur-md" style={{
              backgroundColor: 'rgba(255, 255, 252, 0.1)',
              borderColor: 'rgba(232, 184, 36, 0.2)',
              borderWidth: '1px'
            }} onMouseEnter={(e) => {
              e.currentTarget.style.transform = 'translateY(-4px)';
              e.currentTarget.style.boxShadow = '0 12px 28px rgba(232, 184, 36, 0.15)';
            }} onMouseLeave={(e) => {
              e.currentTarget.style.transform = 'translateY(0)';
              e.currentTarget.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.1)';
            }}>
              <div className="flex items-start justify-between">
                <div className="flex-1">
                  <p className="text-gray-300 text-sm mb-3">Materi</p>
                  <p className="text-4xl font-bold mb-1" style={{ color: '#FFFFFC' }}>{materials.length}</p>
                  <p className="text-gray-400 text-xs">Total materi</p>
                </div>
                <div className="p-3 rounded-lg transform transition-transform hover:scale-110" style={{backgroundColor: '#E8B824'}}>
                  <Video className="h-6 w-6" style={{color: '#1E1E1E'}} />
                </div>
              </div>
            </div>

            {/* Exercises Card */}
            <div className="rounded-xl p-6 transition-all duration-300 hover:shadow-lg cursor-pointer backdrop-blur-md" style={{
              backgroundColor: 'rgba(255, 255, 252, 0.1)',
              borderColor: 'rgba(232, 184, 36, 0.2)',
              borderWidth: '1px'
            }} onMouseEnter={(e) => {
              e.currentTarget.style.transform = 'translateY(-4px)';
              e.currentTarget.style.boxShadow = '0 12px 28px rgba(232, 184, 36, 0.15)';
            }} onMouseLeave={(e) => {
              e.currentTarget.style.transform = 'translateY(0)';
              e.currentTarget.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.1)';
            }}>
              <div className="flex items-start justify-between">
                <div className="flex-1">
                  <p className="text-gray-300 text-sm mb-3">Latihan</p>
                  <p className="text-4xl font-bold mb-1" style={{ color: '#FFFFFC' }}>{exercises.length}</p>
                  <p className="text-gray-400 text-xs">Total latihan</p>
                </div>
                <div className="p-3 rounded-lg transform transition-transform hover:scale-110" style={{backgroundColor: '#E8B824'}}>
                  <Brain className="h-6 w-6" style={{color: '#1E1E1E'}} />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Main Content */}
      <div className="max-w-7xl mx-auto px-6 pt-8 pb-12">
        {/* Quick Actions */}
        <div className="flex items-center justify-between mb-8">
          <div>
            <h2 className="text-2xl font-bold mb-1" style={{ color: "#1A1A1A" }}>Quick Actions</h2>
            <p className="text-sm" style={{ color: "#4A4A4A" }}>Buat konten baru untuk kursus Anda</p>
          </div>
        </div>

        {/* Action Buttons */}
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <Button
            className="rounded-2xl flex-col gap-2 h-20 font-semibold transition-all hover:opacity-90 hover:scale-105 transform backdrop-blur-sm"
            style={{
              backgroundColor: 'rgba(255, 255, 252, 0.8)',
              borderColor: 'rgba(232, 184, 36, 0.2)',
              borderWidth: '1px',
              color: '#1A1A1A'
            }}
            onClick={() => setAddModalState({
              isOpen: true,
              type: "module",
              moduleId: undefined
            })}
            onMouseEnter={(e) => {
              e.currentTarget.style.boxShadow = '0 20px 40px rgba(232, 184, 36, 0.12)';
              e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.4)';
            }}
            onMouseLeave={(e) => {
              e.currentTarget.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.08)';
              e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.2)';
            }}
          >
            <BookOpen className="h-6 w-6" style={{color: '#E8B824'}} />
            <span className="text-sm">Add Module</span>
          </Button>
          <Button
            className="rounded-2xl flex-col gap-2 h-20 font-semibold transition-all hover:opacity-90 hover:scale-105 transform backdrop-blur-sm"
            style={{
              backgroundColor: 'rgba(255, 255, 252, 0.8)',
              borderColor: 'rgba(232, 184, 36, 0.2)',
              borderWidth: '1px',
              color: '#1A1A1A'
            }}
            onClick={() => {
              if (modules.length === 0) {
                alert("Please create a module first before adding lessons");
                return;
              }
              setAddModalState({
                isOpen: true,
                type: "lesson",
                moduleId: modules[0].id
              });
            }}
            onMouseEnter={(e) => {
              e.currentTarget.style.boxShadow = '0 20px 40px rgba(232, 184, 36, 0.12)';
              e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.4)';
            }}
            onMouseLeave={(e) => {
              e.currentTarget.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.08)';
              e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.2)';
            }}
          >
            <FileText className="h-6 w-6" style={{color: '#E8B824'}} />
            <span className="text-sm">Add Lesson</span>
          </Button>
          <Button
            className="rounded-2xl flex-col gap-2 h-20 font-semibold transition-all hover:opacity-90 hover:scale-105 transform backdrop-blur-sm"
            style={{
              backgroundColor: 'rgba(255, 255, 252, 0.8)',
              borderColor: 'rgba(232, 184, 36, 0.2)',
              borderWidth: '1px',
              color: '#1A1A1A'
            }}
            onClick={() => {
              if (modules.length === 0) {
                alert("Please create a module first before adding materials");
                return;
              }
              setAddModalState({
                isOpen: true,
                type: "material",
                moduleId: modules[0].id
              });
            }}
            onMouseEnter={(e) => {
              e.currentTarget.style.boxShadow = '0 20px 40px rgba(232, 184, 36, 0.12)';
              e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.4)';
            }}
            onMouseLeave={(e) => {
              e.currentTarget.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.08)';
              e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.2)';
            }}
          >
            <Video className="h-6 w-6" style={{color: '#E8B824'}} />
            <span className="text-sm">Add Material</span>
          </Button>
          <Button
            className="rounded-2xl flex-col gap-2 h-20 font-semibold transition-all hover:opacity-90 hover:scale-105 transform backdrop-blur-sm"
            style={{
              backgroundColor: 'rgba(255, 255, 252, 0.8)',
              borderColor: 'rgba(232, 184, 36, 0.2)',
              borderWidth: '1px',
              color: '#1A1A1A'
            }}
            onClick={() => setShowExerciseBuilder(true)}
            onMouseEnter={(e) => {
              e.currentTarget.style.boxShadow = '0 20px 40px rgba(232, 184, 36, 0.12)';
              e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.4)';
            }}
            onMouseLeave={(e) => {
              e.currentTarget.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.08)';
              e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.2)';
            }}
          >
            <Brain className="h-6 w-6" style={{color: '#E8B824'}} />
            <span className="text-sm">Add Exercise</span>
          </Button>
        </div>

        {/* Course Structure */}
        <div className="flex items-center justify-between mb-8">
          <div>
            <h2 className="text-2xl font-bold mb-1" style={{ color: "#1A1A1A" }}>Struktur Kursus</h2>
            <p className="text-sm" style={{ color: "#4A4A4A" }}>Kelola modul dan konten pembelajaran Anda</p>
          </div>
        </div>

        {/* Modules List */}
        {modules.length === 0 ? (
          <div className="text-center py-12">
            <div className="p-4 bg-yellow-100 rounded-full inline-flex mb-4">
              <BookOpen className="h-12 w-12 text-yellow-600" />
            </div>
            <h3 className="text-lg font-semibold text-gray-900 mb-2" style={{ color: "#1A1A1A" }}>
              Belum ada modul
            </h3>
            <p className="text-gray-600 mb-6" style={{ color: "#4A4A4A" }}>
              Mulai dengan membuat modul pertama untuk kursus Anda
            </p>
            <Button 
              onClick={() => setAddModalState({
                isOpen: true,
                type: "module",
                moduleId: undefined
              })} 
              className="font-semibold transition-all hover:opacity-90 gap-2"
              style={{ backgroundColor: '#E8B824', color: '#1A1A1A' }}
            >
              <Plus className="h-4 w-4" />
              Buat Modul Pertama
            </Button>
          </div>
        ) : (
          <div className="space-y-6">
            {modules.map((module) => (
              <Card 
                key={module.id} 
                className="rounded-2xl flex flex-col shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden group cursor-pointer backdrop-blur-sm hover:scale-[1.02] transform" 
                style={{
                  backgroundColor: 'rgba(255, 255, 252, 0.8)',
                  borderColor: 'rgba(232, 184, 36, 0.2)',
                  borderWidth: '1px'
                }}
                onMouseEnter={(e) => {
                  e.currentTarget.style.boxShadow = '0 20px 40px rgba(232, 184, 36, 0.12)';
                  e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.4)';
                }}
                onMouseLeave={(e) => {
                  e.currentTarget.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.08)';
                  e.currentTarget.style.borderColor = 'rgba(232, 184, 36, 0.2)';
                }}
              >
                {/* Gradient Top Border */}
                <div 
                  className="h-1"
                  style={{ background: 'linear-gradient(90deg, #E8B824 0%, rgba(232, 184, 36, 0) 100%)' }}
                ></div>
                
                <CardHeader className="pb-3 flex-shrink-0">
                  <div
                    className="cursor-pointer"
                    onClick={() => toggleModule(module.id)}
                  >
                    <div className="flex items-center justify-between mb-2 gap-2">
                      <div className="flex items-center gap-3">
                        <ChevronDown
                          className={`h-4 w-4 transition-transform ${
                            expandedModules.has(module.id) ? "rotate-180" : ""
                          }`}
                          style={{ color: '#E8B824' }}
                        />
                        <div className="p-2 rounded-lg transform transition-transform hover:scale-110" style={{backgroundColor: '#E8B824'}}>
                          <BookOpen className="h-4 w-4" style={{color: '#1E1E1E'}} />
                        </div>
                        <div>
                          <h3 className="font-bold text-lg group-hover:text-yellow-600 transition-colors" style={{ color: "#1A1A1A" }}>
                            {module.title}
                          </h3>
                          {module.description && (
                            <p className="text-sm mt-1" style={{ color: "#4A4A4A" }}>{module.description}</p>
                          )}
                        </div>
                      </div>
                      <div className="flex items-center gap-2">
                        <Badge 
                          className="flex-shrink-0 text-xs font-semibold px-2 py-1 whitespace-nowrap"
                          style={{
                            backgroundColor: 'rgba(232, 184, 36, 0.1)',
                            color: '#E8B824',
                            borderColor: 'rgba(232, 184, 36, 0.2)',
                            borderWidth: '1px'
                          }}
                        >
                          {lessons.filter(l => l.module_id === module.id).length} lessons
                        </Badge>
                        <Badge 
                          className="flex-shrink-0 text-xs font-semibold px-2 py-1 whitespace-nowrap"
                          style={{
                            backgroundColor: 'rgba(232, 184, 36, 0.1)',
                            color: '#E8B824',
                            borderColor: 'rgba(232, 184, 36, 0.2)',
                            borderWidth: '1px'
                          }}
                        >
                          {materials.filter(m => m.module_id === module.id).length} materials
                        </Badge>
                        <Badge 
                          className="flex-shrink-0 text-xs font-semibold px-2 py-1 whitespace-nowrap"
                          style={{
                            backgroundColor: 'rgba(232, 184, 36, 0.1)',
                            color: '#E8B824',
                            borderColor: 'rgba(232, 184, 36, 0.2)',
                            borderWidth: '1px'
                          }}
                        >
                          {exercises.filter(e => e.module_id === module.id).length} exercises
                        </Badge>
                        <Button
                          size="sm"
                          onClick={() => setEditModalState({
                            isOpen: true,
                            type: "module",
                            initialData: module,
                          })}
                          className="gap-1 font-semibold transition-all hover:opacity-90"
                          style={{ backgroundColor: '#E8B824', color: '#1A1A1A' }}
                        >
                          <Edit2 className="h-3 w-3" />
                          Edit
                        </Button>
                        <Button
                          size="sm"
                          onClick={() => onDeleteModule && onDeleteModule(module.id)}
                          className="gap-1 text-red-600 hover:bg-red-50"
                          variant="ghost"
                        >
                          <Trash2 className="h-3 w-3" />
                          Delete
                        </Button>
                      </div>
                    </div>
                  </div>
                </CardHeader>

                {expandedModules.has(module.id) && (
                  <CardContent className="pt-0" style={{ backgroundColor: 'rgba(255, 255, 252, 0.5)' }}>
                    <div className="space-y-4 p-4">
                      
                      {/* Lessons Section */}
                      <div className="rounded-xl p-4 border border-green-200 shadow-sm" style={{ backgroundColor: 'rgba(255, 255, 252, 0.8)' }}>
                        <div className="flex items-center justify-between mb-3">
                          <div className="flex items-center gap-2">
                            <div className="p-1 bg-green-500 rounded">
                              <FileText className="h-3 w-3 text-white" />
                            </div>
                            <div className="text-sm font-bold text-green-800">
                              Lessons ({lessons.filter(l => l.module_id === module.id).length})
                            </div>
                          </div>
                          <Button
                            size="sm"
                            onClick={() => setAddModalState({
                              isOpen: true,
                              type: "lesson",
                              moduleId: module.id
                            })}
                            className="gap-1 h-7 text-xs font-semibold"
                            style={{ backgroundColor: '#E8B824', color: '#1A1A1A' }}
                          >
                            <Plus className="h-3 w-3" />
                            Add
                          </Button>
                        </div>
                        {lessons.filter(l => l.module_id === module.id).map((lesson) => (
                          <div key={lesson.id} className="flex items-center justify-between p-3 bg-white rounded-lg border border-green-200 hover:bg-green-50 hover:shadow-md transition-all duration-200 mb-2">
                            <div className="flex items-center gap-2">
                              <div className="p-1 bg-green-100 rounded">
                                <FileText className="h-3 w-3 text-green-600" />
                              </div>
                              <div>
                                <span className="text-sm font-semibold text-gray-800">{lesson.title}</span>
                                {lesson.description && (
                                  <span className="text-xs text-gray-500 block mt-1">{lesson.description}</span>
                                )}
                              </div>
                            </div>
                            <div className="flex gap-1">
                              <Button 
                                variant="ghost" 
                                size="sm" 
                                className="h-6 w-6 p-0 hover:bg-green-100"
                                onClick={() => onPreviewLesson && onPreviewLesson(lesson)}
                                title="Preview"
                              >
                                <Eye className="h-3 w-3 text-green-600" />
                              </Button>
                              <Button 
                                variant="ghost" 
                                size="sm" 
                                className="h-6 w-6 p-0 hover:bg-green-100"
                                onClick={() => setEditModalState({
                                  isOpen: true,
                                  type: "lesson",
                                  initialData: lesson,
                                })}
                                title="Edit"
                              >
                                <Edit2 className="h-3 w-3 text-green-600" />
                              </Button>
                              <Button 
                                variant="ghost" 
                                size="sm" 
                                className="h-6 w-6 p-0 hover:bg-red-100 text-red-600"
                                onClick={() => onDeleteLesson && onDeleteLesson(lesson.id)}
                                title="Delete"
                              >
                                <Trash2 className="h-3 w-3" />
                              </Button>
                            </div>
                          </div>
                        ))}
                        {lessons.filter(l => l.module_id === module.id).length === 0 && (
                          <div className="text-center py-4 text-green-600 text-sm italic bg-green-50 rounded-lg">
                            No lessons yet
                          </div>
                        )}
                      </div>

                      {/* Materials Section */}
                      <div className="rounded-xl p-4 border border-orange-200 shadow-sm" style={{ backgroundColor: 'rgba(255, 255, 252, 0.8)' }}>
                        <div className="flex items-center justify-between mb-3">
                          <div className="flex items-center gap-2">
                            <div className="p-1 bg-orange-500 rounded">
                              <Video className="h-3 w-3 text-white" />
                            </div>
                            <div className="text-sm font-bold text-orange-800">
                              Materials ({materials.filter(m => m.module_id === module.id).length})
                            </div>
                          </div>
                          <Button
                            size="sm"
                            onClick={() => setAddModalState({
                              isOpen: true,
                              type: "material",
                              moduleId: module.id
                            })}
                            className="gap-1 h-7 text-xs font-semibold"
                            style={{ backgroundColor: '#E8B824', color: '#1A1A1A' }}
                          >
                            <Plus className="h-3 w-3" />
                            Add
                          </Button>
                        </div>
                        {materials.filter(m => m.module_id === module.id).map((material) => (
                          <div key={material.id} className="flex items-center justify-between p-3 bg-white rounded-lg border border-orange-200 hover:bg-orange-50 hover:shadow-md transition-all duration-200 mb-2">
                            <div className="flex items-center gap-2">
                              <div className="p-1 bg-orange-100 rounded">
                                <Video className="h-3 w-3 text-orange-600" />
                              </div>
                              <div>
                                <span className="text-sm font-semibold text-gray-800">{material.title}</span>
                                {material.description && (
                                  <span className="text-xs text-gray-500 block mt-1">{material.description}</span>
                                )}
                              </div>
                            </div>
                            <div className="flex gap-1">
                              <Button 
                                variant="ghost" 
                                size="sm" 
                                className="h-6 w-6 p-0 hover:bg-orange-100"
                                onClick={() => onPreviewMaterial && onPreviewMaterial(material)}
                                title="Preview"
                              >
                                <Eye className="h-3 w-3 text-orange-600" />
                              </Button>
                              <Button 
                                variant="ghost" 
                                size="sm" 
                                className="h-6 w-6 p-0 hover:bg-orange-100"
                                onClick={() => setEditModalState({
                                  isOpen: true,
                                  type: "material",
                                  initialData: material,
                                })}
                                title="Edit"
                              >
                                <Edit2 className="h-3 w-3 text-orange-600" />
                              </Button>
                              <Button 
                                variant="ghost" 
                                size="sm" 
                                className="h-6 w-6 p-0 hover:bg-red-100 text-red-600"
                                onClick={() => onDeleteMaterial && onDeleteMaterial(material.id)}
                                title="Delete"
                              >
                                <Trash2 className="h-3 w-3" />
                              </Button>
                            </div>
                          </div>
                        ))}
                        {materials.filter(m => m.module_id === module.id).length === 0 && (
                          <div className="text-center py-4 text-orange-600 text-sm italic bg-orange-50 rounded-lg">
                            No materials yet
                          </div>
                        )}
                      </div>

                      {/* Exercises Section */}
                      <div className="rounded-xl p-4 border border-purple-200 shadow-sm" style={{ backgroundColor: 'rgba(255, 255, 252, 0.8)' }}>
                        <div className="flex items-center justify-between mb-3">
                          <div className="flex items-center gap-2">
                            <div className="p-1 bg-purple-500 rounded">
                              <Brain className="h-3 w-3 text-white" />
                            </div>
                            <div className="text-sm font-bold text-purple-800">
                              Exercises ({exercises.filter(e => e.module_id === module.id).length})
                            </div>
                          </div>
                          <Button
                            size="sm"
                            onClick={() => setShowExerciseBuilder(true)}
                            className="gap-1 h-7 text-xs font-semibold"
                            style={{ backgroundColor: '#E8B824', color: '#1A1A1A' }}
                          >
                            <Plus className="h-3 w-3" />
                            Add
                          </Button>
                        </div>
                        {exercises.filter(e => e.module_id === module.id).map((exercise) => (
                          <div key={exercise.id} className="flex items-center justify-between p-3 bg-white rounded-lg border border-purple-200 hover:bg-purple-50 hover:shadow-md transition-all duration-200 mb-2">
                            <div className="flex items-center gap-2">
                              <div className="p-1 bg-purple-100 rounded">
                                <Brain className="h-3 w-3 text-purple-600" />
                              </div>
                              <div>
                                <span className="text-sm font-semibold text-gray-800">{exercise.title}</span>
                                {exercise.description && (
                                  <span className="text-xs text-gray-500 block mt-1">{exercise.description}</span>
                                )}
                              </div>
                            </div>
                            <div className="flex gap-1">
                              <Button 
                                variant="ghost" 
                                size="sm" 
                                className="h-6 w-6 p-0 hover:bg-purple-100"
                                onClick={() => onPreviewExercise && onPreviewExercise(exercise)}
                                title="Preview"
                              >
                                <Eye className="h-3 w-3 text-purple-600" />
                              </Button>
                              <Button 
                                variant="ghost" 
                                size="sm" 
                                className="h-6 w-6 p-0 hover:bg-purple-100"
                                onClick={() => setEditModalState({
                                  isOpen: true,
                                  type: "exercise",
                                  initialData: exercise,
                                })}
                                title="Edit"
                              >
                                <Edit2 className="h-3 w-3 text-purple-600" />
                              </Button>
                              <Button 
                                variant="ghost" 
                                size="sm" 
                                className="h-6 w-6 p-0 hover:bg-red-100 text-red-600"
                                onClick={() => onDeleteExercise && onDeleteExercise(exercise.id)}
                                title="Delete"
                              >
                                <Trash2 className="h-3 w-3" />
                              </Button>
                            </div>
                          </div>
                        ))}
                        {exercises.filter(e => e.module_id === module.id).length === 0 && (
                          <div className="text-center py-4 text-purple-600 text-sm italic bg-purple-50 rounded-lg">
                            No exercises yet
                          </div>
                        )}
                      </div>
                    </div>
                  </CardContent>
                )}
              </Card>
            ))}
          </div>
        )}
      </div>

      {/* Edit Content Modal */}
      <EditContentModal
        isOpen={editModalState.isOpen}
        onClose={() => setEditModalState(prev => ({ ...prev, isOpen: false }))}
        type={editModalState.type}
        initialData={editModalState.initialData}
        onSave={async (data) => {
          try {
            if (editModalState.type === "module") {
              await onEditModule && onEditModule(data);
            } else if (editModalState.type === "lesson") {
              await onEditLesson && onEditLesson(data);
            } else if (editModalState.type === "material") {
              await onEditMaterial && onEditMaterial(data);
            } else if (editModalState.type === "exercise") {
              await onEditExercise && onEditExercise(data);
            }
          } catch (error) {
            console.error("Edit failed:", error);
          }
        }}
      />

      {/* Add Content Modal */}
      <AddContentModal
        isOpen={addModalState.isOpen}
        onClose={() => setAddModalState(prev => ({ ...prev, isOpen: false }))}
        type={addModalState.type}
        moduleId={addModalState.moduleId}
        onSave={async (data) => {
          try {
            if (addModalState.type === "module") {
              await onAddModule && onAddModule(data);
            } else if (addModalState.type === "lesson") {
              await onAddLesson && onAddLesson(data);
            } else if (addModalState.type === "material") {
              await onAddMaterial && onAddMaterial(data);
            } else if (addModalState.type === "exercise") {
              await onAddExercise && onAddExercise(data);
            }
          } catch (error) {
            console.error("Add failed:", error);
          }
        }}
      />

      {/* Exercise Builder Modal */}
      <ExerciseBuilderModal
        isOpen={showExerciseBuilder}
        onClose={() => setShowExerciseBuilder(false)}
        onSave={async (data) => {
          try {
            await onAddExercise && onAddExercise(data);
            setShowExerciseBuilder(false);
          } catch (error) {
            console.error("Exercise builder failed:", error);
          }
        }}
      />
    </div>
  );
}
